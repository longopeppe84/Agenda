@page "/order-pizza"
@using Agenda2.Shared.DTOs
@using Agenda2.Client.Services
@inject HttpClient Http
@inject CartService Cart
@inject NavigationManager Navigation
@implements IDisposable

<div class="container-fluid mt-4">
    <div class="row">
        <!-- COLONNA SINISTRA: IL MENU A GRIGLIA -->
        <div class="col-lg-8 mb-4">
            <h3 class="mb-4 fw-bold">🍕 Il Nostro Menu</h3>

            @if (pizzas == null)
            {
                <div class="d-flex align-items-center text-primary">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <em>Caricamento menu...</em>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var pizza in pizzas)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 menu-card">
                                <div class="card-body text-center d-flex flex-column">
                                    <div style="font-size: 5rem; line-height: 1;" class="mb-3">@pizza.ImageUrl</div>
                                    <h5 class="card-title fw-bold">@pizza.Name</h5>
                                    <h6 class="text-success fw-bold mb-2">€ @pizza.Price.ToString("F2")</h6>
                                    <p class="card-text text-muted small flex-grow-1">@pizza.Ingredients</p>
                                    <button class="btn btn-primary w-100 rounded-pill mt-2" @onclick="() => AddToCart(pizza)">
                                        + Aggiungi
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- COLONNA DESTRA: IL CARRELLO -->
        <div class="col-lg-4">
            <h3 class="mb-4 fw-bold">🛒 Il Tuo Ordine</h3>
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white rounded-top">
                    <h5 class="mb-0">Riepilogo</h5>
                </div>
                <div class="card-body">
                    @if (!Cart.Items.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <span style="font-size: 3rem;">🛒</span>
                            <p class="mt-3">Il carrello è vuoto.<br />Scegli una pizza per iniziare!</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3 mb-3">
                            @foreach (var item in Cart.Items)
                            {
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                    <div>
                                        <h6 class="mb-0 fw-bold">@item.Name</h6>
                                        <small class="text-muted">€ @item.Price.ToString("F2")</small>
                                    </div>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFromCart(item)">
                                        🗑️
                                    </button>
                                </div>
                            }
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Totale:</h5>
                            <h4 class="mb-0 text-success">€ @Cart.GetTotal().ToString("F2")</h4>
                        </div>

                        <!-- SELEZIONE CONTATTO -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Per chi è questo ordine?</label>
                            <select class="form-select" @bind="Cart.SelectedContactId">
                                <option value="@Guid.Empty">-- Seleziona un Contatto --</option>
                                @if (contacts != null)
                                {
                                    @foreach (var contact in contacts)
                                    {
                                        <option value="@contact.Id">@contact.Nome @contact.Cognome</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- MESSAGGIO DI ERRORE (se presente) -->
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mb-3">
                                @errorMessage
                            </div>
                        }

                        <button class="btn btn-success w-100 btn-lg rounded-pill" @onclick="ConfirmOrder" disabled="@(Cart.SelectedContactId == Guid.Empty || isProcessing)">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Conferma Ordine
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODALE DI SUCCESSO -->
@if (showSuccessModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-success">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">✅ Ordine Confermato</h5>
                </div>
                <div class="modal-body text-center py-4">
                    <h5>Grazie per il tuo ordine!</h5>
                    <p class="text-muted">Le pizze sono state assegnate al contatto selezionato.</p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-success btn-lg px-5" @onclick="CloseAndRedirect">Torna alla Home</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PizzaDto>? pizzas;
    private List<ContactDto>? contacts;
    private bool showSuccessModal = false;
    private string? errorMessage;
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Carica le pizze
            pizzas = await Http.GetFromJsonAsync<List<PizzaDto>>("api/pizza");
            // Carica i contatti per la tendina
            contacts = await Http.GetFromJsonAsync<List<ContactDto>>("api/contact");
        }
        catch (Exception ex)
        {
            errorMessage = "Errore nel caricamento dei dati: " + ex.Message;
        }

        Cart.OnChange += StateHasChanged;
    }

    private void AddToCart(PizzaDto pizza) => Cart.AddPizza(pizza);
    private void RemoveFromCart(PizzaDto pizza) => Cart.RemovePizza(pizza);

    private async Task ConfirmOrder()
    {
        if (Cart.Items.Any() && Cart.SelectedContactId != Guid.Empty)
        {
            try
            {
                isProcessing = true;
                errorMessage = null;

                var orderDto = new OrderDto
                    {
                        ContactId = Cart.SelectedContactId,
                        Items = Cart.Items.Select(i => new OrderItemDto
                        {
                            PizzaId = i.Id,
                            Quantity = 1,
                            Price = i.Price
                        }).ToList()
                    };

                var response = await Http.PostAsJsonAsync("api/order", orderDto);

                if (response.IsSuccessStatusCode)
                {
                    showSuccessModal = true;
                }
                else
                {
                    // Legge il messaggio di errore restituito dal server
                    var error = await response.Content.ReadAsStringAsync();
                    errorMessage = $"Errore dal server ({(int)response.StatusCode}): {error}";
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Errore di connessione: " + ex.Message;
            }
            finally
            {
                isProcessing = false;
            }
        }
        else
        {
            errorMessage = "Seleziona un contatto prima di confermare l'ordine.";
        }
    }

    private void CloseAndRedirect()
    {
        showSuccessModal = false;
        Cart.Clear();
        Navigation.NavigateTo("", forceLoad: true);
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }
}.
