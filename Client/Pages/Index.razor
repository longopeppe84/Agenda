@page "/"

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <!-- Icona e Titolo -->
            <div class="mb-4">
                <span style="font-size: 5rem;">📒</span>
                <h1 class="display-4 fw-bold mt-3 text-primary">Agenda 2</h1>
                <p class="lead text-muted">Il tuo gestionale personale per contatti, indirizzi e relazioni.</p>
            </div>

            <!-- Card di Benvenuto -->
            <div class="card shadow-sm border-0 mb-5">
                <div class="card-body p-5">
                    <h3 class="card-title mb-3">Benvenuto!</h3>
                    <p class="card-text text-secondary mb-4">
                        Da qui puoi gestire in modo semplice e veloce tutti i tuoi contatti.
                        Puoi aggiungere nuove persone, associare più indirizzi, tenere traccia delle relazioni parentali
                        e molto altro ancora.
                    </p>

                    <!-- Pulsanti di azione -->
                    <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                        <a href="contacts" class="btn btn-primary btn-lg px-4 gap-3">
                            📇 Vai alla Lista Contatti
                        </a>
                        <a href="contacts/create" class="btn btn-success btn-lg px-4">
                            ➕ Nuovo Contatto
                        </a>
                    </div>
                </div>
            </div>

            <!-- Piccole info in basso -->
            <div class="row text-muted mt-4">
                <div class="col-md-4 mb-3">
                    <h5>👥 Contatti</h5>
                    <p class="small">Gestisci le tue conoscenze in un unico posto.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>📍 Indirizzi</h5>
                    <p class="small">Associa più indirizzi a ogni persona.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5>👨‍👩‍👧 Relazioni</h5>
                    <p class="small">Tieni traccia dei legami familiari e non solo.</p>
                </div>
            </div>

        </div>
    </div>
</div>