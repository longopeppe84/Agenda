@page "/contacts"
@using Agenda2.Shared.DTOs

<h3 class="mb-4 fw-bold">📇 Lista Contatti</h3>

<div class="mb-4">
    <a href="contacts/create" class="btn btn-primary shadow-sm">
        ➕ Nuovo Contatto
    </a>
</div>

@if (contacts == null)
{
    <div class="d-flex align-items-center text-primary">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        <em>Caricamento in corso...</em>
    </div>
}
else if (!contacts.Any())
{
    <div class="alert alert-info">Nessun contatto trovato. Inseriscine uno nuovo!</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var contact in contacts)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0 fw-bold">@contact.Nome @contact.Cognome</h5>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-1">
                                <span class="me-2">✉️</span>
                                <small class="text-muted">@contact.Email</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="me-2">📞</span>
                                <small class="text-muted">@contact.Telefono</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <h6 class="text-secondary fw-bold mb-2">📍 Indirizzi</h6>
                            @if (contact.Addresses.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var addr in contact.Addresses)
                                    {
                                        <li class="small mb-1">@addr.Street, @addr.City (@addr.ZipCode)</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Nessun indirizzo</span>
                            }
                        </div>

                        <div class="mb-3 flex-grow-1">
                            <h6 class="text-secondary fw-bold mb-2">👨‍👩‍👧 Relazioni</h6>
                            @if (contact.Relationships.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var rel in contact.Relationships)
                                    {
                                        <li class="small mb-1">@rel.RelationshipType: @rel.RelativeName</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">Nessuna relazione</span>
                            }
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a href="contacts/edit/@contact.Id" class="btn btn-warning btn-sm flex-fill">
                                ✏️ Modifica
                            </a>
                            <button class="btn btn-danger btn-sm flex-fill" @onclick="() => OpenDeleteModal(contact)">
                                🗑️ Elimina
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (showDeleteModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Conferma Eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    Sei sicuro di voler eliminare il contatto <strong>@contactToDelete?.Nome @contactToDelete?.Cognome</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Annulla</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Elimina
                    </button>
                </div>
            </div>
        </div>
    </div>
}