@page "/contacts"
@using Agenda2.Shared.DTOs
@inject HttpClient Http

<h3>Lista Contatti</h3>

<div class="mb-3">
    <a href="contacts/create" class="btn btn-primary">Nuovo Contatto</a>
</div>

@if (contacts == null)
{
    <div class="d-flex align-items-center">
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        <em>Caricamento in corso...</em>
    </div>
}
else if (!contacts.Any())
{
    <div class="alert alert-info">Nessun contatto trovato. Inseriscine uno nuovo!</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Cognome</th>
                <th>Email</th>
                <th>Telefono</th>
                <th>Indirizzi</th>
                <th>Relazioni</th>
                <th>Azioni</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var contact in contacts)
            {
                <tr>
                    <td>@contact.Nome</td>
                    <td>@contact.Cognome</td>
                    <td>@contact.Email</td>
                    <td>@contact.Telefono</td>
                    <td>
                        @if (contact.Addresses.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var addr in contact.Addresses)
                                {
                                    <li>📍 @addr.Street, @addr.City (@addr.ZipCode)</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted small">Nessun indirizzo</span>
                        }
                    </td>
                    <td>
                        @if (contact.Relationships.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var rel in contact.Relationships)
                                {
                                    <li>👨‍👩‍👧 @rel.RelationshipType: @rel.RelativeName</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted small">Nessuna relazione</span>
                        }
                    </td>
                    <td>
                        <a href="contacts/edit/@contact.Id" class="btn btn-sm btn-warning">Modifica</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => OpenDeleteModal(contact)">Elimina</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- MODALE BOOTSTRAP PER L'ELIMINAZIONE -->
@if (showDeleteModal)
{
    <div class="modal-backdrop fade show" style="z-index: 1040;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Conferma Eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body">
                    Sei sicuro di voler eliminare il contatto <strong>@contactToDelete?.Nome @contactToDelete?.Cognome</strong>?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Annulla</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Elimina
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<ContactDto>? contacts;

    // Variabili per la modale
    private bool showDeleteModal = false;
    private bool isDeleting = false;
    private ContactDto? contactToDelete;

    protected override async Task OnInitializedAsync() => await LoadContacts();

    private async Task LoadContacts() => contacts = await Http.GetFromJsonAsync<IEnumerable<ContactDto>>("api/contact");

    private void OpenDeleteModal(ContactDto contact)
    {
        contactToDelete = contact;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        contactToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (contactToDelete != null)
        {
            try
            {
                isDeleting = true;
                await Http.DeleteAsync($"api/contact/{contactToDelete.Id}");
                CloseDeleteModal();
                await LoadContacts();
            }
            finally
            {
                isDeleting = false;
            }
        }
    }
}